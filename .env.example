# Riot Games API
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_REGION=la1                  # la1 = LAN, la2 = LAS, na1 = NA, euw1 = EUW
RIOT_ROUTING=americas            # americas | europe | asia | sea

# Tu cuenta
SUMMONER_NAME=TuNombreAca
SUMMONER_TAG=LAN                 # el tag después del #

# Storage local: DuckDB (un único archivo, sin servidor ni free tier que se duerma).
# Por defecto el pipeline usa <raíz>/warddata.duckdb. Descomentá para overridear:
# DUCKDB_PATH=/home/<usuario>/ward-eye/warddata.duckdb
